# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# THE DATA DIRECTORY IS NEVER COMMITTED.
# server/data holds the SQLite database (opc.db + its WAL/SHM), the vault key
# that decrypts every stored credential, and the managed SearXNG install. A copy
# of the database carries ciphertext; the key beside it makes that ciphertext
# readable. Neither belongs in a repository, private or not.
/server/data/
/server/src/data/
*.db
*.db-wal
*.db-shm
vault.key

# Credentials in any other shape
.env
.env.*
!.env.example
*.p8
*.pem
*.key
*-token
*-token.json
*-key.json
*-keys.json

# Logs and scratch
logs/
*.log
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.swp

# THE GENERATED SERVICE FILES.
# `npm run install-service` writes a launchd plist or a systemd unit here, and
# both name absolute paths on ONE machine — this Node binary, this checkout,
# this user's home. Committing one would install somebody else's paths. The
# generator is the source (server/src/integrations/deploy/service.ts); these are
# its output, regenerated by the command whenever they are wanted.
/deploy/out/
# The service's environment file. It holds paths and numbers rather than
# secrets, but it is the owner's own configuration for THEIR box: an
# OPC_DATA_DIR from this machine is wrong on every other one.
/deploy/opc.env
