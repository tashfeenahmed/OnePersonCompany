# Where the SQLite file and the vault key live. One directory, so a backup is
# a copy of one directory.
OPC_DATA_DIR=./data

# The API listens here; the Vite dev server proxies /api to it.
PORT=8787

# Loopback by default. Set an owner password before serving on your LAN.
# Then use 0.0.0.0, explicitly list the
# browser URL in OPC_ALLOWED_ORIGINS, and restrict the port with your firewall.
OPC_BIND_HOST=127.0.0.1
OPC_ALLOWED_ORIGINS=

# Minutes between automatic collections. 0 turns the scheduler off and leaves
# collection to POST /api/plugins/:id/collect.
OPC_COLLECT_MINUTES=30

# How long readings are kept. Snapshots are cheap but not free.
OPC_RETAIN_DAYS=400
